# ==============================================================================
# RefineBoard - Environment Configuration
# ==============================================================================

# Backend Server Port
PORT=5000

# Supabase PostgreSQL Connection String
# Get this from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Use Transaction Pooler (port 6543) or Direct connection (port 5432)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.wnioshgaevbtymrcytul.supabase.co:5432/postgres"

# JWT Secret Key for signing authentication tokens
JWT_SECRET="some-long-random-secret-key"

# Allowed Frontend Client URL for CORS
CLIENT_URL="http://localhost:5173"

# Node Environment
NODE_ENV="development"

# Frontend API URL (Used by Vite during build/dev)
VITE_API_URL="http://localhost:5000/api"
